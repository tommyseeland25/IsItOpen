# Server-side only. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=your-api-key-here

# Best-effort in-memory daily caps on real Google calls (UTC day). Cache hits don't count.
# Nearby Search (Enterprise tier, 1,000 free calls/month): 30/day stays under it.
DAILY_NEARBY_SEARCH_LIMIT=30
GEOCODE_DAILY_LIMIT=200
